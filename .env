# Absolute URL of the live site, no trailing slash. Not a secret.
# Used for the canonical link, og:url, og:image and twitter:image in index.html.
# Left empty, Vercel builds use the project's production domain automatically
# (see vite.config.js). Set it to pin a URL, e.g. VITE_SITE_URL=https://www.example.com
VITE_SITE_URL=
